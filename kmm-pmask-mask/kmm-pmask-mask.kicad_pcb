	(gr_text_box "Designed for JLCPCB Flex Process\n\nSpecifications:\nDielectric Thickness: 25 μm \nPCB Thickness: 0.12 mm\nCopper Type: Electro-deposited\nSurface Finish: ENIG\nGold Thickness: 1 U{dblquote}\nOuter Copper Weight: 0.5 oz/ft^{2}\nStiffener: Yes, PI (Polyimide) 0.2 mm\nEMI shielding: No\nCutting Method: Laser\nSilkscreen on Stiffener: No\n\nRemark:\nStiffener geometry specified on separate layer."
		(start 130 30)
		(end 170 60)
		(margins 1.0025 1.0025 1.0025 1.0025)
		(layer "Cmts.User")
		(uuid "c3a57745-dd81-475d-87ee-f2572b807232")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left top)
		)
		(border yes)
		(stroke
			(width 0.1)
			(type solid)
		)
		(knockout no)
	)
	(gr_text_box "Remarks on Assembly:\n\nIt is recommended to pre-bake this board before assembly and reflow.\nUse low-temp solder paste (Sn42/Bi58) if possible. Otherwise reflow temperature must not exceed 260 °C.\nThree fiducial marks are provided but automated assembly is not recommended without addition of a fixture."
		(start 130 65)
		(end 170 85)
		(margins 1.0025 1.0025 1.0025 1.0025)
