	(text "2.2 µH 2.1 A"
		(exclude_from_sim no)
		(at 63.5 92.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fce8ec5d-4085-4c63-bf66-47dda2a34464")
	)
	(text_box "A linear regulator was chosen for simplicity. As efficiency is 78.6% at the worst-case voltage drop (VBATT = 4.2 V), a switching regulator should be substituted if battery life is a significant concern.\n"
		(exclude_from_sim no)
		(at 20.32 172.72 0)
		(size 60.96 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "36f8f5df-b9d8-4bd9-bf6c-700acf590d4f")
	)
	(text_box "Expected battery chemistry:\n1S LiPo, unknown capacity\n\nCustomer requested mutiple battery connection points, including a 2.54 mm pin header.\nDo not connect both at the same time."
		(exclude_from_sim no)
		(at 20.32 57.15 0)
		(size 41.91 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3b16e445-a6ee-4d1e-aa53-18a2ec0aa724")
	)
	(text_box "It is very difficult to estimate the actual power consumption of a board until a prototype is built.\nAs such, this revision is built to support the maximum requirements of all components. \nIn future revisions, it is perfectly fine to reduce current supply capability to better align with our usage patterns."
		(exclude_from_sim no)
		(at 204.47 111.76 0)
		(size 67.31 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "559e03db-9201-44a2-8d01-c204d6451f11")
	)
	(text_box "A 1/2 Voltage divider to allow the MCU to approximate the current battery percentage."
		(exclude_from_sim no)
		(at 204.47 64.77 0)
		(size 29.21 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a02b21d2-461f-4729-8cee-fdd3814f0d62")
	)
	(text_box "A linear regulator was chosen despite the large voltage drop due to the very small required current (5 mA).\nAs such, the trade off of lower efficiency for simplicity is justified."
		(exclude_from_sim no)
		(at 90.17 172.72 0)
		(size 60.96 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
